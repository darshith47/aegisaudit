APP_NAME=AegisAudit
ENVIRONMENT=development

# Database & Cache Settings
DATABASE_URL=postgresql+psycopg://aegisaudit:aegisaudit@postgres:5432/aegisaudit
REDIS_URL=redis://redis:6379/0

# Authentication & Security
JWT_SECRET=CHANGE_ME_FOR_LOCAL_DEVELOPMENT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Security Engine Settings
MOCK_ENGINE=true

# Resource Policies
MAX_CONCURRENT_JOBS=2
MAX_JOB_RUNTIME_SECONDS=1800
MAX_WORDLIST_SIZE_MB=1024

# Logging
LOG_LEVEL=INFO
