# ==============================================================================
# AegisAudit Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - Never commit a real .env file containing production secrets to version control.
# - Always keep MOCK_ENGINE=true unless operating in an authorized testing lab.
# - Replace CHANGE_ME with a strong secret before running in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
APP_NAME=AegisAudit
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL (Production / Docker Compose default):
DATABASE_URL=postgresql+psycopg://aegisaudit:aegisaudit@postgres:5432/aegisaudit

# SQLite (Local development alternative - zero configuration):
# DATABASE_URL=sqlite:///./aegisaudit.db

# ------------------------------------------------------------------------------
# 3. Redis Cache & Job Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key for signing JWT tokens.
# IN PRODUCTION: The application will REFUSE to start if this key contains 'CHANGE_ME'.
# Generate a cryptographically secure 64-byte key using:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_DO_NOT_USE_IN_PRODUCTION_GENERATE_WITH_SECRETS_TOKEN_URLSAFE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Allowed CORS Origins (comma-separated list of authorized web origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. Security Engines & Safe Demonstration Mode
# ------------------------------------------------------------------------------
# WARNING: Keep MOCK_ENGINE=true for safe simulations and portfolio demonstrations.
# Setting MOCK_ENGINE=false enables execution of native security assessment tools.
# ONLY set to false inside authorized lab networks (e.g., Kali Linux).
MOCK_ENGINE=true

# Tool binary executable paths (default Kali Linux locations):
HASHCAT_PATH=/usr/bin/hashcat
JOHN_PATH=/usr/sbin/john
HYDRA_PATH=/usr/bin/hydra

# Wordlist path (default Kali Linux SecLists / RockYou location):
WORDLIST_PATH=/usr/share/wordlists/rockyou.txt

# ------------------------------------------------------------------------------
# 6. Resource Limits & Execution Policies
# ------------------------------------------------------------------------------
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=1800
MAX_WORDLIST_SIZE_MB=1024

# ------------------------------------------------------------------------------
# 7. Frontend Integration
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
